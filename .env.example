# ====================================================================
# VAHAD – Tourist Management System (VAHAD-TMS)
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure your values.
# ====================================================================

# [Security]
# Generate a cryptographically secure random secret key in production.
# Example: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-secure-50-character-random-secret-key

# Set DEBUG=False in production. Default is False when omitted.
DEBUG=False

# Comma-separated allowed hostnames/domains
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app,.fly.dev

# Comma-separated trusted origins for CSRF protection on HTTPS deployments
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.railway.app,https://*.fly.dev,http://localhost:8000,http://127.0.0.1:8000

# Timezone (Default: Asia/Kolkata)
TIME_ZONE=Asia/Kolkata

# ====================================================================
# Database Configuration
# ====================================================================
# Primary Production Choice: PostgreSQL via DATABASE_URL
# Example: postgresql://vahad_user:vahad_password@db-host:5432/vahad_db
DATABASE_URL=

# Local Development Options:
# Set USE_SQLITE=True to use local SQLite database file
USE_SQLITE=True

# Or configure MySQL connection parameters:
# DB_NAME=Vahadtms
# DB_USER=root
# DB_PASSWORD=your_local_mysql_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ====================================================================
# SSL / HTTPS Security Headers (Set to True in production HTTPS)
# ====================================================================
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
